{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aich.design/schemas/planschema.json",
  "title": "PlanStructure",
  "description": "AICH Design 平面方案中间表示（设计文档 §5.2 + ADR-005 顶层 schemaVersion）。schemaVersion 缺省视为 1。",
  "type": "object",
  "required": ["schemaVersion", "bounds", "rooms", "walls"],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "default": 1,
      "description": "ADR-005：顶层版本号；迁移注册表见 packages/shared/src/migrations.ts"
    },
    "bounds": {
      "type": "object",
      "required": ["widthM", "heightM"],
      "properties": {
        "widthM": { "type": "number", "minimum": 0 },
        "heightM": { "type": "number", "minimum": 0 }
      }
    },
    "rooms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "type", "x", "y", "w", "h", "orientation"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "type": {
            "enum": ["bedroom", "living", "kitchen", "bath", "study", "balcony", "corridor", "other"]
          },
          "x": { "type": "number" },
          "y": { "type": "number" },
          "w": { "type": "number", "minimum": 0 },
          "h": { "type": "number", "minimum": 0 },
          "orientation": { "enum": ["N", "S", "E", "W", "NE", "NW", "SE", "SW"] },
          "areaM2": { "type": "number", "minimum": 0 },
          "adjacentTo": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "walls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "x1", "y1", "x2", "y2"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string" },
          "x1": { "type": "number" },
          "y1": { "type": "number" },
          "x2": { "type": "number" },
          "y2": { "type": "number" },
          "thicknessMm": { "type": "number", "minimum": 0, "default": 200 },
          "hasDoor": { "type": "boolean" },
          "hasWindow": { "type": "boolean" }
        }
      }
    },
    "openings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "wallId"],
        "additionalProperties": true,
        "properties": {
          "kind": { "enum": ["door", "window"] },
          "wallId": { "type": "string" },
          "offsetM": { "type": "number", "minimum": 0 },
          "widthM": { "type": "number", "minimum": 0 }
        }
      }
    }
  }
}