{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "outDir": "dist-electron",
    "rootDir": ".",
    "sourceMap": true
  },
  "include": ["electron", "vite.config.ts"],
  "exclude": ["electron/**/*.test.ts", "node_modules"]
}