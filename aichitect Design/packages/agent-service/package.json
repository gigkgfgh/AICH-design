{
  "name": "@aichdesign/agent-service",
  "version": "0.1.0",
  "private": true,
  "description": "AICH Design Agent Service：独立 Node 进程，内嵌 pi-agent-core（AgentRuntimePort 适配）+ 本地网关（HTTP/SSE：POST /v1/run、GET /v1/stream/:requestId、POST /v1/cancel）+ 会话 jsonl + usage/cost 埋点；依赖不可装时降级 MockAdapter 全链路",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "bin": {
    "aich-agent-service": "dist/main.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "test": "vitest --run && node test/server.js --smoke",
    "smoke": "node test/server.js --smoke",
    "smoke:p018-p019": "node test/smoke-p018-p019.mjs"
  },
  "dependencies": {
    "@aichdesign/extensions": "*",
    "@aichdesign/mock-provider": "*",
    "@aichdesign/shared": "*",
    "@earendil-works/pi-agent-core": "0.84.1",
    "@earendil-works/pi-ai": "0.84.1",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "typescript": "~5.6.2",
    "vitest": "^2.1.1"
  }
}