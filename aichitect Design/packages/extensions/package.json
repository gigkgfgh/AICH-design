      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest --run",
    "lint": "vitest --run"
  },
  "dependencies": {
    "@aichdesign/shared": "*"
  },
  "devDependencies": {
    "@aichdesign/mock-provider": "*",
    "@types/node": "^22.5.0",
    "typescript": "~5.6.2",
    "vitest": "^2.1.1"
  }
}